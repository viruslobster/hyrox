! echo ".schema sets" | sqlite3 workouts.sqlite -cmd ".headers on" -cmd ".mode box"
CREATE TABLE sets (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    workout_name TEXT NOT NULL,
    date INTEGER NOT NULL,
    lap INTEGER NOT NULL,
    total_time INTEGER NOT NULL,
    difference INTEGER NOT NULL,
    FOREIGN KEY (workout_name) REFERENCES workouts(name)
);
#~


#!
echo "
   SELECT workout_name, COUNT(DISTINCT date) AS times_done
   FROM sets
   GROUP BY workout_name
   ORDER BY times_done DESC;

" | sqlite3 workouts.sqlite -cmd ".headers on" -cmd ".mode box"
